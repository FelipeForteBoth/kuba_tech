# ─────────────────────────────────────────────────────────────
# Kuba Tech — variáveis de ambiente
# Copie este arquivo para backend/.env e preencha os valores.
# ─────────────────────────────────────────────────────────────

# Conexão com o Supabase (PostgreSQL)
# Onde achar: Supabase > Project Settings > Database > Connection string > URI
# Use a conexão "Transaction" (pooler, porta 6543) para produção,
# ou "Session"/direta (porta 5432) em desenvolvimento.
# Formato: postgresql://usuario:SENHA@host:5432/postgres
DATABASE_URL=postgresql://postgres:SUA_SENHA_DO_BANCO@db.SEU_PROJETO.supabase.co:5432/postgres

# SSL é exigido pelo Supabase (deixe true). Para Postgres local: false
DB_SSL=true

# Tamanho máximo do pool de conexões
DB_POOL_MAX=10

# Chave usada para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET=kuba_secret_2026

# Porta da API
PORT=3000

# URL do front-end (para CORS e links nos e-mails)
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# E-mail automático (opcional — use uma das opções)
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_FROM=no-reply@kubatech.com.br
MAIL_FROM_NAME=Kuba Tech

# Upload de fotos/assinaturas (opcional — Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mapbox (opcional — geolocalização)
MAPBOX_TOKEN=

# Consulta de CPF (opcional — {cpf} será substituído pelo número)
CPF_API_URL=
CPF_API_TOKEN=

# Mostrar detalhes de erros no retorno da API (use true só em desenvolvimento)
DEBUG_ERRORS=true
